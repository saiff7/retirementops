# Copy is generated automatically by: uv run python scripts/dev_bootstrap.py
# That script writes .env with random values. Never commit .env. Placeholders only below.

RETIREMENTOPS_ENV=dev

# --- Database (docker compose, localhost only)
RO_DB_HOST=127.0.0.1
RO_DB_PORT=55432
RO_DB_NAME=retirementops
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__generate__

# --- Per-connector Postgres roles (ADR-003). One secret per role.
RO_PW_RO_OWNER=__generate__
RO_PW_APP_SERVICE=__generate__
RO_PW_SVC_ZENDESK_READER=__generate__
RO_PW_SVC_ZENDESK_WRITER=__generate__
RO_PW_SVC_PLANADMIN_READER=__generate__
RO_PW_SVC_PAYROLL_READER=__generate__
RO_PW_SVC_PAYROLL_INGEST=__generate__
RO_PW_SVC_SERVICEKB_READER=__generate__
RO_PW_SVC_AGENT_RECORDER=__generate__

# --- Mock identity (NOT production SSO). Keys are generated into keys/ (git-ignored).
RO_JWT_PRIVATE_KEY_PATH=keys/dev_jwt_private.pem
RO_JWT_PUBLIC_KEY_PATH=keys/dev_jwt_public.pem
RO_JWT_ISSUER=retirementops-dev
RO_JWT_AUDIENCE=retirementops-api
RO_JWT_TTL_SECONDS=900
# RO_AGENT_RUN_TTL_SECONDS=600

# --- Local model (Ollama, loopback only); defaults shown
# RO_OLLAMA_URL=http://127.0.0.1:11434
# RO_OLLAMA_MODEL=qwen3:8b
# RO_OLLAMA_TIMEOUT_SECONDS=120

# --- Logging: HMAC key used to pseudonymise participant refs in logs.
RO_LOG_PEPPER=__generate__
# HMAC key for pseudonymising participant refs and client addresses in the audit log (separate key).
RO_AUDIT_PEPPER=__generate__

# --- Abuse protection (ADR-012); defaults shown
# RO_RL_CLIENT_PER_MINUTE=300
# RO_RL_CLIENT_BURST=60
# RO_RL_AUTH_FAILURES_PER_MINUTE=10
# RO_RL_PRINCIPAL_PER_MINUTE=600
# RO_RL_PRINCIPAL_BURST=120
# RO_AUDIT_ANON_PER_CLIENT_PER_WINDOW=2
# RO_AUDIT_ANON_GLOBAL_PER_WINDOW=60
